ion\n                for start,end in silent_time_intervals:\n                    silence = end-start\n                    if(silence == max_silence):\n                        max_locations.append((start,end))\n                \n                # naming type of location        \n                for max_start,max_end in max_locations:\n                    # CASE B: START silence\n                    if(max_start == 0):\n                        silence_type.append('START')\n                    # CASE C: END silence\n                    if(max_end == duration):\n                        silence_type.append('END')\n                    # CASE A: Fully silent\n                    if(max_start == 0 and max_end == duration):\n                        silence_type.append('Fully')\n                    # CASE D: MIDDLE silence\n                    if(max_start != 0 and max_end != duration):\n                        silence_type.append('MIDDLE')\n                    \n                    \n        \n                # Store result\n                if max_silence >= threshold_sec:\n                    records.append({\n                         \"Genre\": g,\n                         \"Stem\": s,\n                         \"Duration\": round(total_silence, 2),\n                         \"Max_Silence_Sec\": round(max_silence, 2),\n                         \"Silence_Location\": \", \".join(silence_type),\n                         \"File_Path\": path\n                    })\n    #-------------------------------------------------------------------------\n    print(\"Total file scaned : \", total_files)\n    print(\"Length of records : \",len(records))\n    df = pd.DataFrame(records)\n    return df\n    #return silent_time_intervals\n\n# --- EXECUTION ---\n# Pass your 'tr' (training) dictionary here.\n# Ensure 'tr' is defined from your previous build_dataset code.\ndf_silence = find_long_silences(tr, threshold_sec=DURATION, top_db=TOP_DB)\n\n# --- RESULTS ANALYSIS ---\n\n# --------------