d+1\n    \n    if prev_end < len(y):\n        silent_sample_intervals.append((prev_end, len(y)))\n    #---#\n    silent_time_intervals = [\n        (start / sr, end / sr) for start, end in silent_sample_intervals\n    ]\n    #---#\n    silences = [end-start for start,end in silent_time_intervals]\n    if len(silences) != 0:\n        max_silence = np.max(silences) \n        total_silence = np.sum(silences) \n        max_silence_type = set()\n        f_0_5 = 0\n        # finding max silence location\n        for start,end in silent_time_intervals: \n            if(max_silence==end-start):\n                if (start == 0) :\n                    max_silence_type.add('START')\n                    if(end-start >= 0.5):\n                        f_0_5 = 1\n                if(end == duration):\n                    max_silence_type.add('END')\n                if(start == 0 and end == duration):\n                    max_silence_type.add('FULL')   \n                if(start != 0 and end != duration):\n                    max_silence_type.add('MIDDLE') \n    else:\n        max_silence = 0\n        total_silence = 0\n        max_silence_type = 'NO'\n        f_0_5 = 0\n                \n    return max_silence,total_silence,max_silence_type,f_0_5\n\ndef extract_stems_information(stem_path_dict,_t=None):\n    \"\"\"\n     It will extract all stemfile information and store it in a DataFrame for later analysis.\n     Example : {\n         genre,\n         stem,\n         sample_rate,\n         total_length,\n         duration,\n         size,\n         peak_amplitude (in dB)\n    }\n    Returns a DataFrame.\n    \"\"\"\n    df = pd.DataFrame(\n        index=range(4000),\n        columns=[\n             \"genre\",\n             \"stem\",\n             \"sample_rate\",\n             \"total_length\",\n             \"duration\",\n             \"size\",\n             \"peak_amplitude\",\n             \"mean_spectral_centroid\",\n             \"silence_in_the_first_0.5\",\n             \"total_silence\",\n             \"max_silence\",\n             \"max_silence_type\"\n        ])\n    j = 0\n    index = 100\n    if(_t == 'T'):\n        index = 83\n    if(_t == 'V'):\n        index = 17\n        \n    for g in GENRES:\n        for s in STEM_KEYS:\n            for i in range(0,index):\n                path = stem_path_dict[g][s][i]\n                y,sr = lb.load(path = path,sr=SR)    # taking original sr and duration\n                duration = lb.get_duration(y=y,sr=sr)\n                total_length = sr*duration\n                size = os.path.getsize(path)\n                \n                peak_amplitude_db = np.max(lb.amplitude_to_db(y))\n                mean_spectral_centroid = np.mean(lf.spectral_centroid(y=y,sr=SR))\n                \n                max_silence,total_silence,max_silence_type,f_0_5 = get_silence_information(y,sr,duration,TOP_DB=20)\n                df.loc[j] = [g,s,sr,total_length,duration,size,peak_amplitude_db,mean_spectral_centroid,f_0_5,total_silence,max_silence,max_silence_type]\n                            \n                j = j + 1\n    return df\n\n\nprint(\"✅\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-02-25T03:17:03.483663Z","iopub.execute_input":"2026-02-25T03:17:03.484009Z","iopub.status.idle":"2026-02-25T03:17:03.503329Z","shell.execute_reply.started":"2026-02-25T03:17:03.483984Z","shell.execute_reply":"2026-02-25T03:17:03.502548Z"}},"outputs":[{"name":"stdout","text":"✅\n","output_type":"stream"}],"execution_count":21},{"cell_type":"code","source":"tr, val,sl = build_dataset(DATA_ROOT)\nprint(\"✅ Dataset building complete \")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-02-25T02:49:27.639819Z","iopub.execute_input":"2026-02-25T02:49:27.640108Z","iopub.status.idle":"2026-02-25T02:49:34.084699Z","shell.execute_reply.started":"2026-02-25T02:49:27.640085Z","shell.execute_reply":"2026-02-25T02:49:34.083981Z"}},"outputs":[{"name":"stdout","text":"Total number of stems m